rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidPublicUserProfile(data) {
      return data.keys().hasAll(['uid', 'name', 'handle', 'memberId', 'badgeType', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'name', 'handle', 'memberId', 'badgeType', 'createdAt', 'updatedAt']) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.uid == request.auth.uid &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
        data.handle is string && data.handle.size() >= 2 && data.handle.size() <= 60 &&
        data.memberId is string && data.memberId.size() >= 3 && data.memberId.size() <= 40 &&
        data.badgeType is string && data.badgeType.size() <= 20 &&
        data.badgeType in ['none', 'silver', 'gold', 'platinum', 'blue', 'developer'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidPrivateUserInfo(data) {
      return data.keys().hasAll(['uid', 'email', 'phone', 'location', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'email', 'phone', 'location', 'updatedAt']) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.uid == request.auth.uid &&
        data.email is string && data.email.size() <= 160 &&
        data.phone is string && data.phone.size() <= 40 &&
        data.location is string && data.location.size() <= 120 &&
        data.updatedAt is timestamp;
    }

    function isValidPrayerRequest(data) {
      return data.keys().hasAll(['authorId', 'authorName', 'title', 'body', 'prayingCount', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['authorId', 'authorName', 'title', 'body', 'prayingCount', 'status', 'createdAt', 'updatedAt']) &&
        data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128 && data.authorId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 100 &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 140 &&
        data.body is string && data.body.size() >= 1 && data.body.size() <= 1000 &&
        data.prayingCount is int && data.prayingCount >= 0 && data.prayingCount <= 1000000 &&
        data.status is string && data.status.size() <= 20 && data.status in ['active', 'answered'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidLiveDecree(data) {
      return data.keys().hasAll(['authorId', 'authorName', 'text', 'createdAt']) &&
        data.keys().hasOnly(['authorId', 'authorName', 'text', 'createdAt']) &&
        data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128 && data.authorId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.authorId == request.auth.uid &&
        data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 100 &&
        data.text is string && data.text.size() >= 1 && data.text.size() <= 500 &&
        data.createdAt is timestamp;
    }

    function isValidGivingReceipt(data) {
      return data.keys().hasAll(['ownerId', 'receiptCode', 'amount', 'formattedAmount', 'currency', 'fund', 'method', 'status', 'createdAt']) &&
        data.keys().hasOnly(['ownerId', 'receiptCode', 'amount', 'formattedAmount', 'currency', 'fund', 'method', 'status', 'createdAt']) &&
        data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerId == request.auth.uid &&
        data.receiptCode is string && data.receiptCode.size() >= 5 && data.receiptCode.size() <= 40 &&
        data.amount is number && data.amount > 0 && data.amount <= 1000000 &&
        data.formattedAmount is string && data.formattedAmount.size() >= 1 && data.formattedAmount.size() <= 40 &&
        data.currency is string && data.currency.size() <= 10 && data.currency in ['USD', 'ZiG', 'GBP', 'ZAR'] &&
        data.fund is string && data.fund.size() >= 1 && data.fund.size() <= 80 &&
        data.method is string && data.method.size() >= 1 && data.method.size() <= 40 &&
        data.status is string && data.status.size() <= 20 && data.status == 'completed' &&
        data.createdAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && existing().uid == userId;
      allow create: if isVerifiedUser() &&
        isValidId(userId) &&
        userId == request.auth.uid &&
        isValidPublicUserProfile(incoming()) &&
        incoming().badgeType == 'none' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() &&
        isValidId(userId) &&
        isValidPublicUserProfile(incoming()) &&
        userId == request.auth.uid &&
        existing().uid == request.auth.uid &&
        incoming().uid == existing().uid &&
        incoming().memberId == existing().memberId &&
        incoming().badgeType == existing().badgeType &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'handle', 'updatedAt']);

      match /private/{docId} {
        allow get: if isVerifiedUser() &&
          isValidId(userId) &&
          isValidId(docId) &&
          userId == request.auth.uid &&
          existing().uid == request.auth.uid &&
          exists(/databases/$(database)/documents/users/$(userId)) &&
          get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;
        allow create: if isVerifiedUser() &&
          isValidId(userId) &&
          isValidId(docId) &&
          docId == 'info' &&
          userId == request.auth.uid &&
          isValidPrivateUserInfo(incoming()) &&
          incoming().updatedAt == request.time &&
          exists(/databases/$(database)/documents/users/$(userId)) &&
          get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;
        allow update: if isVerifiedUser() &&
          isValidId(userId) &&
          isValidId(docId) &&
          docId == 'info' &&
          userId == request.auth.uid &&
          isValidPrivateUserInfo(incoming()) &&
          existing().uid == request.auth.uid &&
          incoming().uid == existing().uid &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['email', 'phone', 'location', 'updatedAt']) &&
          exists(/databases/$(database)/documents/users/$(userId)) &&
          get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;
      }
    }

    match /prayerRequests/{prayerId} {
      allow get: if isSignedIn() && isValidId(prayerId) && existing().status in ['active', 'answered'];
      allow list: if isSignedIn() && resource.data.status in ['active', 'answered'];
      allow create: if isVerifiedUser() &&
        isValidId(prayerId) &&
        isValidPrayerRequest(incoming()) &&
        incoming().authorId == request.auth.uid &&
        incoming().prayingCount == 1 &&
        incoming().status == 'active' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/users/$(incoming().authorId)) &&
        get(/databases/$(database)/documents/users/$(incoming().authorId)).data.uid == request.auth.uid;
      allow update: if isVerifiedUser() &&
        isValidId(prayerId) &&
        isValidPrayerRequest(incoming()) &&
        existing().status == 'active' &&
        incoming().authorId == existing().authorId &&
        incoming().authorName == existing().authorName &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          (
            existing().authorId == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly(['title', 'body', 'status', 'updatedAt'])
          ) ||
          (
            incoming().status == existing().status &&
            incoming().title == existing().title &&
            incoming().body == existing().body &&
            incoming().prayingCount == existing().prayingCount + 1 &&
            incoming().diff(existing()).affectedKeys().hasOnly(['prayingCount', 'updatedAt'])
          )
        );
      allow delete: if isVerifiedUser() && isValidId(prayerId) && existing().authorId == request.auth.uid;
    }

    match /decrees/{decreeId} {
      allow get: if isSignedIn() && isValidId(decreeId) && existing().text.size() <= 500;
      allow list: if isSignedIn() && resource.data.text.size() <= 500;
      allow create: if isVerifiedUser() &&
        isValidId(decreeId) &&
        isValidLiveDecree(incoming()) &&
        incoming().createdAt == request.time &&
        exists(/databases/$(database)/documents/users/$(incoming().authorId)) &&
        get(/databases/$(database)/documents/users/$(incoming().authorId)).data.uid == request.auth.uid;
      allow delete: if isVerifiedUser() && isValidId(decreeId) && existing().authorId == request.auth.uid;
    }

    match /givingReceipts/{receiptId} {
      allow get: if isVerifiedUser() && isValidId(receiptId) && existing().ownerId == request.auth.uid;
      allow list: if isVerifiedUser() && resource.data.ownerId == request.auth.uid;
      allow create: if isVerifiedUser() &&
        isValidId(receiptId) &&
        isValidGivingReceipt(incoming()) &&
        incoming().createdAt == request.time &&
        exists(/databases/$(database)/documents/users/$(incoming().ownerId)) &&
        get(/databases/$(database)/documents/users/$(incoming().ownerId)).data.uid == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
