{
  "expo": {
    "name": "GatewayConnect",
    "slug": "gatewayconnect",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#193B37"
    },
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "gatewayconnect",
    "plugins": [
      "expo-background-task",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#193B37"
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.gatewaychurch.gatewayconnect"
    },
    "android": {
      "package": "org.gatewaychurch.gatewayconnect"
    },
    "web": {
      "bundler": "metro"
    }
  }
}
