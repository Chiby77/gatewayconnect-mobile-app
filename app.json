{
  "expo": {
    "name": "GatewayConnect",
    "slug": "gatewayconnect",
    "version": "1.0.1",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0a0a0a",
    "scheme": "gatewayconnect",
    "plugins": [
      "expo-background-task",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#193B37"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "backgroundColor": "#0a0a0a"
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      "expo-asset",
      "react-native-compressor",
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInRelease": true
          }
        }
      ],
      "expo-status-bar",
      "expo-system-ui"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.gatewaychurch.gatewayconnect"
    },
    "android": {
      "package": "org.gatewaychurch.gatewayconnect",
      "permissions": [
        "android.permission.INTERNET"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "bf2cf1fe-ffc1-4b53-9289-1c18ad7384d5"
      }
    }
  }
}
